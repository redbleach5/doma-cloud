# Doma Cloud — example environment configuration.
# Copy to `.env` and adjust before running `docker compose up -d`.

# --- Core app ---
# Generate a strong random secret:
#   openssl rand -base64 48
DOMA_JWT_SECRET=replace-me-with-a-strong-random-secret-please

# Secret for the trash-cleanup cron endpoint.
# Generate with: openssl rand -hex 32
# Required if you want to enable auto-purge of old trash.
CRON_SECRET=replace-me-with-a-random-cron-secret

# Set to "1" if you're behind a self-signed HTTPS cert on local network
# (so the browser sends the cookie over plain HTTP from the LAN IP).
DOMA_INSECURE_COOKIE=1

# Public URL of the app — used for share links.
# Use your LAN IP or hostname. With Tailscale Funnel later, your funnel URL.
NEXT_PUBLIC_APP_URL=http://mini-pc.local

# --- Storage backend ---
# local  → store files on a mounted volume (default, simplest)
# s3     → use MinIO or any S3-compatible service
STORAGE_DRIVER=local

# When STORAGE_DRIVER=local, files go here. Mount your BTRFS RAID1 here.
STORAGE_LOCAL_ROOT=/data/doma-storage

# When STORAGE_DRIVER=s3, configure MinIO:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=doma-minio
# S3_SECRET_KEY=replace-me-too
# S3_BUCKET=doma

# --- Database ---
# SQLite lives next to the app container (mount a volume).
DATABASE_URL=file:/app/db/doma.db

# --- Next.js ---
NODE_ENV=production
