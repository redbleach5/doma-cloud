# Doma Cloud — example environment configuration.
# Copy to `.env` and adjust before running `docker compose up -d`.

# --- Core app ---
# Generate a strong random secret:
#   openssl rand -base64 48
DOMA_JWT_SECRET=replace-me-with-a-strong-random-secret-please

# Secret for the trash-cleanup / uploads-cleanup cron endpoints.
# Generate with: openssl rand -hex 32
# Required if you want to enable auto-purge of old trash.
CRON_SECRET=replace-me-with-a-random-cron-secret

# Set to "1" ONLY if you must use plain HTTP (e.g. accessing via LAN IP and
# you can't import the self-signed Caddy CA into the client device). With the
# default value (0) session cookies are marked Secure and won't be sent over
# HTTP — which is the safe default. Note that Caddyfile.prod now redirects
# HTTP → HTTPS, so plain HTTP access no longer works at all unless you edit it.
DOMA_INSECURE_COOKIE=0

# Public URL of the app — used for share links.
# Use your LAN hostname. With Tailscale Funnel later, your funnel URL.
# Default is HTTPS because Caddyfile.prod serves HTTPS on port 443.
NEXT_PUBLIC_APP_URL=https://mini-pc.local

# LAN hostname for the self-signed TLS cert. Caddy issues a cert on demand
# for whatever SNI the client sends, but setting this explicitly helps some
# clients (notably Windows WebDAV) pick the right cert.
DOMA_DOMAIN=mini-pc.local

# --- Storage backend ---
# local  → store files on a mounted volume (default, simplest)
# s3     → use MinIO or any S3-compatible service
STORAGE_DRIVER=local

# When STORAGE_DRIVER=local, files go here. Mount your BTRFS RAID1 here.
STORAGE_LOCAL_ROOT=/data/doma-storage

# When STORAGE_DRIVER=s3, configure MinIO:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=doma-minio
# S3_SECRET_KEY=replace-me-too
# S3_BUCKET=doma

# --- Database ---
# SQLite lives next to the app container (mount a volume).
DATABASE_URL=file:/app/db/doma.db

# --- Next.js ---
NODE_ENV=production
