# Doma Cloud — example environment configuration.
# Copy to `.env` and fill in secrets before `bun run dev` / `bun run start`.

# --- Core app ---
# Generate a strong random secret:
#   openssl rand -base64 48
DOMA_JWT_SECRET=replace-me-with-a-strong-random-secret-please

# Secret for trash / uploads / share cleanup cron endpoints.
# Generate with: openssl rand -hex 32
# Required header: X-Cron-Secret
CRON_SECRET=replace-me-with-a-random-cron-secret

# Set to "1" for plain HTTP (localhost / LAN IP without HTTPS).
# Behind HTTPS (Caddy, Tailscale Funnel, etc.) leave at 0 (Secure cookies).
DOMA_INSECURE_COOKIE=1

# Optional LAN hostname (handy if you put Caddy or Tailscale in front).
DOMA_DOMAIN=localhost

# Timezone for logs and scheduled behaviour.
TZ=Europe/Moscow

# Directory where user files are stored (absolute or relative to process cwd).
# Linux/macOS:  STORAGE_LOCAL_ROOT=/mnt/raid/doma
# Windows:      STORAGE_LOCAL_ROOT=D:\doma
STORAGE_LOCAL_ROOT=./storage-data

# --- Ops / production (optional) ---
# PORT=3000
# DOMA_BACKUP_DIR=../doma-backups
# DOMA_BACKUP_KEEP=7
# DOMA_HEALTH_HOST=127.0.0.1

# --- Video posters (optional) ---
# ffmpeg/ffprobe are strictly an enhancement (video thumbnails). Without them
# the app works as before and shows icons instead of posters.
# Linux: `sudo apt install ffmpeg` — found via PATH automatically.
# Windows: put ffmpeg.exe/ffprobe.exe into tools/ffmpeg/bin/ (git-ignored), or:
# FFMPEG_PATH=D:/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=D:/tools/ffmpeg/bin/ffprobe.exe

# --- Database ---
# SQLite file. For a portable disk, keep it next to files, e.g.:
#   DATABASE_URL=file:/mnt/raid/doma/.doma/db/doma.db
DATABASE_URL=file:./doma.db

# Trusted reverse-proxy hops for client IP (rate limits). Default 1 = Caddy/nginx
# in front of the app. Set 0 if the app is exposed directly (ignores X-Forwarded-For).
# TRUSTED_PROXY_HOPS=1

# --- Next.js ---
# Do not set NODE_ENV here — `bun run dev` / `bun run start` manage it.
