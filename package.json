{
  "name": "doma-cloud",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1",
    "build": "next build && bun scripts/copy-standalone.mjs",
    "start": "NODE_ENV=production bun .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "test": "bun scripts/run-tests-serially.mjs tests",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun scripts/run-tests-serially.mjs tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storage:migrate-keys": "bun scripts/storage-migrate-keys.mjs",
    "storage:verify": "bun scripts/storage-verify.mjs --orphans",
    "test:stress-upload": "bun scripts/stress-upload.mjs",
    "test:setup": "bunx prisma db push --schema=prisma/schema.prisma --skip-generate",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "prod:health-win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/healthcheck.ps1",
    "prod:cron-win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/cron-run.ps1",
    "prod:backup-win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/backup.ps1",
    "prod:restore-win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/restore.ps1",
    "prod:install-tasks-win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/install-tasks.ps1",
    "prod:uninstall-tasks-win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prod/uninstall-tasks.ps1",
    "prod:health": "bash scripts/prod/healthcheck.sh",
    "prod:cron": "bash scripts/prod/cron-run.sh",
    "prod:backup": "bash scripts/prod/backup.sh",
    "prod:restore": "bash scripts/prod/restore.sh",
    "prod:smoke-ops": "bash scripts/prod/smoke-ops.sh",
    "prod:install-launchd": "bash scripts/prod/install-launchd.sh",
    "prod:uninstall-launchd": "bash scripts/prod/uninstall-launchd.sh",
    "prod:install-systemd": "bash scripts/prod/install-systemd.sh",
    "prod:uninstall-systemd": "bash scripts/prod/uninstall-systemd.sh"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.82.0",
    "@tanstack/react-virtual": "^3.14.6",
    "@wrksz/themes": "^1.0.0",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.525.0",
    "mime-types": "^3.0.2",
    "nanoid": "^5.1.16",
    "next": "^16.1.1",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "sharp": "^0.34.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "^8.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}